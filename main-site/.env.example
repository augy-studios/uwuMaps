# uwuMaps' Vercel environment variables. Set these in the Vercel project, not in a committed file.

# ---- Supabase: share links and saved places sync ----
# Project Settings > API. The service role (or sb_secret_) key stays on the server, in the API
# routes only. Without these two the app still works, but short share links and sync are off.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key

# ---- Offline packs (optional) ----
# Where the pack files are published. Only set this to point at a different release.
# MAP_RELEASE_URL=https://github.com/augy-studios/uwuMaps/releases/download/offline-packs
